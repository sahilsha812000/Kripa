OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Select "gemini", "groq", "openrouter", "ollama", "openai", or "anthropic" ("claude" is also accepted).
KRIPA_PROVIDER=gemini

# Local Ollama server and model. Gemini automatically falls back to this provider.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional model overrides. Defaults: gemini-3.5-flash-lite, gpt-6.2-astra,
# claude-sonnet-5, openai/gpt-oss-120b (Groq), and openai/gpt-oss-120b (OpenRouter).
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=openai/gpt-oss-120b
# OPENAI_MODEL=gpt-6.2-astra
# ANTHROPIC_MODEL=claude-sonnet-5
